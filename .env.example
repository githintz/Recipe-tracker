# Optional. When set, imports use Claude to parse recipes that have no
# structured data (Instagram/TikTok captions, free-form blog posts) and to
# read recipes out of photos. Without a key the app falls back to its
# built-in structured-data + heuristic parsers, which still handle most
# recipe websites.
ANTHROPIC_API_KEY=

# Optional. Where the SQLite database lives. Defaults to ./data/ladle.db
LADLE_DB_PATH=
