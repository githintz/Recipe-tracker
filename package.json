{
  "name": "ladle",
  "version": "1.0.0",
  "private": true,
  "description": "Save, read and cook recipes from social media and the web.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "sync:android": "npm run build && cap sync android",
    "apk": "npm run sync:android && cd android && ./gradlew assembleDebug",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke",
    "test": "node --import tsx scripts/parsers.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "better-sqlite3": "^11.10.0",
    "next": "^15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "playwright": "^1.56.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}
